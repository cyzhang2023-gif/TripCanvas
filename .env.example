# ─── 客户端（浏览器可见，只放公开的 JS API Key）───
# 腾讯地图 JavaScript API GL Key（地图展示）
# 申请地址：https://lbs.qq.com/dev/console/key/manage
VITE_TENCENT_MAP_KEY=

# ─── 服务端专用（不会暴露到前端 bundle）───
# Deepseek AI API Key
DEEPSEEK_API_KEY=

# 高德 Web 服务 Key（路线规划 & 地理编码）
AMAP_WEB_KEY=

# 是否开启实时路线规划（调用高德/OSRM 获取真实路线）
ENABLE_LIVE_ROUTE_PLANNING=false
